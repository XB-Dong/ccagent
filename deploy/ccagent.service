[Unit]
Description=cc operations workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ccagent
Group=ccagent
WorkingDirectory=/opt/ccagent/current
EnvironmentFile=/opt/ccagent/config/service.env
ExecStart=/opt/ccagent/tooling/node-v24.19.0-linux-x64/bin/node apps/server/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ccagent
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1500M
TasksMax=128

[Install]
WantedBy=multi-user.target
