[Unit]
Description=HTTPS entry for cc operations workbench
After=network-online.target ccagent.service
Wants=network-online.target

[Service]
Type=simple
User=ccagent-caddy
Group=ccagent-caddy
Environment=HOME=/var/lib/ccagent-caddy
ExecStart=/opt/ccagent/tooling/caddy run --config /opt/ccagent/config/Caddyfile --adapter caddyfile
ExecReload=/opt/ccagent/tooling/caddy reload --config /opt/ccagent/config/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ccagent-caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
